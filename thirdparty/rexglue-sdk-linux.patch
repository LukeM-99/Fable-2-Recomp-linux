 }
 
+// Shadow of the page protections applied through this file (AllocFixed,
+// DeallocFixed, Protect, MapFileView, UnmapFileView), so QueryProtect does not
+// have to parse /proc/self/maps. That parse is very slow and sits on the hot
+// path: every guest write to a GPU-watched page faults into
+// MMIOHandler::ExceptionCallback, which re-queries the page protection while
+// holding the global lock the GPU command processor also needs.
+// Two levels: 1 GiB chunks of the 47-bit user address space, then one byte
+// per host page (0 = unknown -> fall back to /proc, else PageAccess + 1).
+// Lookups are lock-free and never allocate (safe in the signal handler).
+constexpr unsigned kShadowChunkShift = 30;
+constexpr size_t kShadowChunkCount = size_t(1) << (47 - kShadowChunkShift);
+std::atomic<std::atomic<uint8_t>*> g_shadow_chunks[kShadowChunkCount];
+
+inline unsigned ShadowPageShift() {
+  static const unsigned shift = unsigned(__builtin_ctzll(uint64_t(getpagesize())));
+  return shift;
+}
+
+std::atomic<uint8_t>* ShadowChunk(size_t index, bool create) {
+  std::atomic<uint8_t>* chunk = g_shadow_chunks[index].load(std::memory_order_acquire);
+  if (chunk || !create) {
+    return chunk;
+  }
+  const size_t pages = size_t(1) << (kShadowChunkShift - ShadowPageShift());
+  auto* fresh = new std::atomic<uint8_t>[pages]();
+  if (g_shadow_chunks[index].compare_exchange_strong(chunk, fresh, std::memory_order_acq_rel)) {
+    return fresh;
+  }
+  delete[] fresh;
+  return chunk;
+}
+
+// state: 0 = forget (unknown), otherwise PageAccess + 1.
+void ShadowSet(const void* base_address, size_t length, uint8_t state) {
+  if (!length) {
+    return;
+  }
+  const unsigned page_shift = ShadowPageShift();
+  uintptr_t page = reinterpret_cast<uintptr_t>(base_address) >> page_shift;
+  const uintptr_t page_end =
+      (reinterpret_cast<uintptr_t>(base_address) + length + (uintptr_t(1) << page_shift) - 1) >>
+      page_shift;
+  const unsigned chunk_page_shift = kShadowChunkShift - page_shift;
+  const uintptr_t chunk_page_mask = (uintptr_t(1) << chunk_page_shift) - 1;
+  while (page < page_end) {
+    const size_t chunk_index = page >> chunk_page_shift;
+    const uintptr_t run_end = std::min(page_end, (uintptr_t(chunk_index) + 1) << chunk_page_shift);
+    if (chunk_index >= kShadowChunkCount) {
+      return;
+    }
+    if (std::atomic<uint8_t>* chunk = ShadowChunk(chunk_index, state != 0)) {
+      for (uintptr_t p = page; p < run_end; ++p) {
+        chunk[p & chunk_page_mask].store(state, std::memory_order_relaxed);
+      }
+    }
+    page = run_end;
+  }
+}
+
+inline void ShadowSetAccess(const void* base_address, size_t length, PageAccess access) {
+  ShadowSet(base_address, length, uint8_t(uint8_t(access) + 1));
+}
+
+// Returns 0 when the page is unknown.
+inline uint8_t ShadowGet(const void* address) {
+  const unsigned page_shift = ShadowPageShift();
+  const uintptr_t page = reinterpret_cast<uintptr_t>(address) >> page_shift;
+  const unsigned chunk_page_shift = kShadowChunkShift - page_shift;
+  const size_t chunk_index = page >> chunk_page_shift;
+  if (chunk_index >= kShadowChunkCount) {
+    return 0;
+  }
+  std::atomic<uint8_t>* chunk = ShadowChunk(chunk_index, false);
+  if (!chunk) {
+    return 0;
+  }
+  return chunk[page & ((uintptr_t(1) << chunk_page_shift) - 1)].load(std::memory_order_relaxed);
+}
+
+inline bool ShadowRangeKnown(const void* base_address, size_t length) {
+  const size_t page = size_t(1) << ShadowPageShift();
+  const uintptr_t begin = reinterpret_cast<uintptr_t>(base_address) & ~uintptr_t(page - 1);
+  const uintptr_t end = reinterpret_cast<uintptr_t>(base_address) + length;
+  for (uintptr_t a = begin; a < end; a += page) {
+    if (!ShadowGet(reinterpret_cast<const void*>(a))) {
+      return false;
+    }
+  }
+  return true;
+}
+
 }  // namespace
 #endif  // REX_PLATFORM_LINUX
 
